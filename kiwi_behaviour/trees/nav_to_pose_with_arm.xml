<!--
  Task-level tree: stow arm, navigate to pose, deploy arm.
  Nav2 handles replanning and recovery internally.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="NavWithArm">

      <ArmMoveNamed group_name="combined" target_name="home"
                    server_name="/bt/arm_move_named"/>

      <NavigateToPose goal="{target_pose}"
                      server_name="/navigate_to_pose"/>

      <ArmMoveNamed group_name="combined" target_name="ready"
                    server_name="/bt/arm_move_named"/>

    </Sequence>
  </BehaviorTree>
</root>
